---
import { getCollection } from "astro:content";
import type { Page, GetStaticPathsOptions } from "astro";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/CardPost.astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection("posts");
  const sortedPosts = allPosts
  .filter((post) => new Date(post.data.date).valueOf() < new Date().valueOf())
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );
  return paginate(sortedPosts, { pageSize: 2 });
}

interface Props {
  page: Page<CollectionEntry<"posts">>;
}

const { page } = Astro.props;

const pageTitle = "Domenico Tenace - Blog";
const pageDescription =
  "I write articles about the technologies I use the most and share my experiences";
---

<Layout pageTitle={pageTitle} pageDescription={pageDescription}>
  <h2>Blog</h2>
  <ul role="list" class="link-card-grid">
    {
      page.data.map((cardPost) => (
        <Card
          url={`/blog/${cardPost.id}/`}
          image={cardPost.data.image?.url ?? "/images/OG_Image.webp"}
          title={cardPost.data.title}
          date={cardPost.data.date}
        />
      ))
    }
  </ul>

  {
    (page.url.prev || page.url.next) && (
      <nav aria-label="Pagination" class="pagination">
        {page.url.prev ? (
          <a href={page.url.prev} class="pagination-link">
            &larr; Past
          </a>
        ) : (
          <span class="pagination-link disabled">&larr; Past</span>
        )}
        {page.url.next ? (
          <a href={page.url.next} class="pagination-link">
            Next &rarr;
          </a>
        ) : (
          <span class="pagination-link disabled">Next &rarr;</span>
        )}
      </nav>
    )
  }
</Layout>

