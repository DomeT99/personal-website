---
import Layout from "../layouts/Layout.astro";
const pageTitle = "404 - Page Not Found";
const pageDescription = "It seems like you've wandered into the wrong forest!";
---

<Layout pageTitle={pageTitle} pageDescription={pageDescription}>
  <div class="lost">
    <h1 class="lost__header">404</h1>
    <p class="lost__body">
      It seems like you've wandered into the wrong forest!
    </p>
    <p>
      <a class="lost__link" href="/">Return Home</a>
    </p>
  </div>
</Layout>
