---
import BaseLayout from "./Layout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  frontmatter: CollectionEntry<"posts">["data"] & { description?: string };
}

const { frontmatter } = Astro.props;
---

<BaseLayout
  pageTitle={frontmatter.title}
  pageDescription={frontmatter.description}
>
  <h1 class="post__title">{frontmatter.title}</h1>
  <ul class="badge__list">
    <li>
      <span class="badge badge--item">AUTHOR</span>{frontmatter.author}
    </li>
    <li>
      <span class="badge badge--item">PUBLISHED</span>{frontmatter.date}
    </li>
  </ul>
  <slot />
</BaseLayout>

