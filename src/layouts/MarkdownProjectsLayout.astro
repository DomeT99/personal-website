---
import BaseLayout from "./Layout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const frontmatter = entry.data;

const baseUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://domenicotenace.dev";
const url = `${baseUrl}/projects/${entry.id}/`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: frontmatter.title,
  description: frontmatter.description,
  author: {
    "@type": "Person",
    name: "Domenico Tenace",
    url: "https://domenicotenace.dev/",
  },
  ...(frontmatter.github && { codeRepository: frontmatter.github }),
  ...(frontmatter.website && { url: frontmatter.website }),
};
---

<BaseLayout
  pageTitle={`${frontmatter.title} - Domenico Tenace`}
  pageDescription={frontmatter.description}
  canonicalURL={url}
  structuredData={structuredData}
>
  <h1 class="page-title">{frontmatter.title}</h1>
  <slot />
  <ul class="badge__list">
    {
      frontmatter.platform !== undefined && (
        <li>
          <span class="badge badge--item">PLATFORM</span>
          {frontmatter.platform}
        </li>
      )
    }
    {
      frontmatter.stack !== undefined && (
        <li>
          <span class="badge badge--item">STACK</span>
          {frontmatter.stack}
        </li>
      )
    }

    {
      frontmatter.website !== undefined && (
        <li>
          <span class="badge badge--item">WEBSITE</span>
          <a class="badge__link" href={frontmatter.website} target="_blank" rel="noopener noreferrer">
            {frontmatter.website}
          </a>
        </li>
      )
    }
    {
      frontmatter.github !== undefined && (
        <li>
          <span class="badge badge--item">GITHUB</span>
          <a class="badge__link" href={frontmatter.github} target="_blank" rel="noopener noreferrer">
            {frontmatter.github}
          </a>
        </li>
      )
    }
  </ul>
</BaseLayout>