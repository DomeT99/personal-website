---
interface Props {
    url: string;
    image: string;
    title: string;
    date: string;
}

const { url, image, title, date } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<li class="card">
    <a class="card__link" href={url}>
        <div class="center">
            <img
                class="card__img"
                src={image}
                role="presentation"
                width="226"
                height="127"
                loading="lazy"
                decoding="async"
            />
        </div>
        <h3 class="card__title">
            {title}
        </h3>
        <p class="card__txt">
            <time datetime={date}>{formattedDate}</time>
        </p>
    </a>
</li>

